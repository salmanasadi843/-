rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // دسترسی کاربران؛ قواعد فعلی حفظ شده است
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null
                         && request.auth.uid == userId;
    }

    // اشتراک‌گذاری قبلی؛ قواعد فعلی حفظ شده است
    match /shared/{shareId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null
                            && resource.data.ownerUid == request.auth.uid;
    }

    // همگام‌سازی مطالب منتشرشده؛ قواعد فعلی حفظ شده است
    match /shared_materials/{teacherUid} {
      allow read: if request.auth != null;
      allow create, update, delete:
        if request.auth != null
        && request.auth.uid == teacherUid;
    }

    // نسخه پشتیبان خصوصی درس‌یار؛ فقط صاحب حساب استاد اجازه دسترسی دارد
    match /teacher_data/{ownerUid} {
      allow read: if request.auth != null
                  && request.auth.uid == ownerUid;

      allow create, update: if request.auth != null
                            && request.auth.uid == ownerUid
                            && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'TEACHER'
                            && request.resource.data.ownerUid == ownerUid;

      allow delete: if request.auth != null
                    && request.auth.uid == ownerUid
                    && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'TEACHER';

      // رکوردهای جداگانه برای همگام‌سازی کلاس‌ها، درس‌ها و جلسات
      // فقط صاحب حساب استاد اجازه خواندن و نوشتن دارد
      match /records/{recordId} {
        allow read: if request.auth != null
                    && request.auth.uid == ownerUid;

        allow create, update, delete: if request.auth != null
                                      && request.auth.uid == ownerUid
                                      && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'TEACHER';
      }
    }
  }
}