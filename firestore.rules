rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /shared_materials/{ownerUid} {
      // هر کاربر واردشده می‌تواند مطالب منتشرشده را بخواند.
      allow read: if request.auth != null;

      // فقط خود صاحب حساب با نقش استاد اجازه انتشار یا حذف دارد.
      allow create, update, delete: if request.auth != null
        && request.auth.uid == ownerUid
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'TEACHER'
        && request.resource.data.ownerUid == ownerUid;
    }
  }
}