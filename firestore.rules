rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isPrimaryTeacher() {
      return request.auth != null
             && request.auth.token.email == 'salmanasadi843@gmail.com';
    }

    function approvedTeacher(uid) {
      return request.auth != null
             && request.auth.uid == uid
             && exists(/databases/$(database)/documents/users/$(uid))
             && get(/databases/$(database)/documents/users/$(uid)).data.role == 'TEACHER'
             && (
               isPrimaryTeacher()
               || (
                 exists(/databases/$(database)/documents/approved_teachers/$(uid))
                 && (
                   get(/databases/$(database)/documents/approved_teachers/$(uid)).data.enabled == true
                   || get(/databases/$(database)/documents/approved_teachers/$(uid)).data.approved == true
                 )
               )
             );
    }

    // پروفایل کاربر: نقش استاد فقط توسط مدیر اصلی قابل اعطا یا تغییر است.
    match /users/{userId} {
      allow read: if request.auth != null
                  && (request.auth.uid == userId || isPrimaryTeacher());
      allow create: if isPrimaryTeacher()
                    || (request.auth != null
                        && request.auth.uid == userId
                        && request.resource.data.role == 'STUDENT');
      allow update: if isPrimaryTeacher()
                    || (request.auth != null
                        && request.auth.uid == userId
                        && request.resource.data.role == resource.data.role);
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // داده‌های خصوصی زیرمجموعه حساب؛ درخواست استاد برای مدیر نیز قابل بررسی است.
    match /users/{userId}/{collectionName}/{document=**} {
      allow read, write: if request.auth != null
                         && request.auth.uid == userId;
    }

    match /users/{userId}/teacher_requests/{requestId} {
      allow read: if request.auth != null
                  && (request.auth.uid == userId || isPrimaryTeacher());
      allow create, update: if request.auth != null
                            && request.auth.uid == userId
                            && request.resource.data.uid == userId;
      allow update: if isPrimaryTeacher();
    }

    // صف مرکزی درخواست‌ها؛ فقط صاحب درخواست ثبت می‌کند و مدیر آن را بررسی می‌کند.
    match /teacher_requests/{uid} {
      allow create: if (isPrimaryTeacher()
                       && request.resource.data.uid == uid
                       && request.resource.data.status in ['APPROVED', 'REJECTED', 'REVOKED'])
                    || (request.auth != null
                        && request.auth.uid == uid
                        && request.resource.data.uid == uid
                        && request.resource.data.status == 'PENDING');
      allow update: if isPrimaryTeacher()
                    || (request.auth != null
                        && request.auth.uid == uid
                        && request.resource.data.uid == uid
                        && request.resource.data.status == 'PENDING');
      allow read: if request.auth != null
                  && (request.auth.uid == uid || isPrimaryTeacher());
      allow delete: if isPrimaryTeacher();
    }

    // مجوز استاد: خواندن برای حساب‌های واردشده؛ ایجاد/تغییر/حذف فقط برای مدیر اصلی.
    // این مسیر برای بررسی مجوز هنگام ورود استاد لازم است.
    match /approved_teachers/{teacherUid} {
      allow read: if request.auth != null;
      allow create, update: if isPrimaryTeacher()
                            && request.resource.data.ownerUid == teacherUid
                            && request.resource.data.enabled == true;
      allow delete: if isPrimaryTeacher();
    }

    // اشتراک‌گذاری قبلی؛ قواعد فعلی حفظ شده است
    match /shared/{shareId} {
      allow read: if true;
      allow create: if approvedTeacher(request.auth.uid)
                    && request.resource.data.ownerUid == request.auth.uid;
      allow update: if approvedTeacher(request.auth.uid)
                            && resource.data.ownerUid == request.auth.uid
                            && request.resource.data.ownerUid == request.auth.uid;
      allow delete: if approvedTeacher(request.auth.uid)
                    && resource.data.ownerUid == request.auth.uid;
    }

    // همگام‌سازی مطالب منتشرشده؛ قواعد فعلی حفظ شده است
    match /shared_materials/{teacherUid} {
      allow read: if request.auth != null;
      allow create, update: if approvedTeacher(teacherUid)
                            && request.resource.data.ownerUid == teacherUid;
      allow delete: if approvedTeacher(teacherUid)
                    && resource.data.ownerUid == teacherUid;
    }

    function activeTeacher(uid) {
      return exists(/databases/$(database)/documents/users/$(uid))
             && get(/databases/$(database)/documents/users/$(uid)).data.role == 'TEACHER'
             && (
               uid == 'xgUdnaQ6X0hPobOUwx3SDI0BJVc2'
               || (
                 exists(/databases/$(database)/documents/approved_teachers/$(uid))
                 && (
                   get(/databases/$(database)/documents/approved_teachers/$(uid)).data.enabled == true
                   || get(/databases/$(database)/documents/approved_teachers/$(uid)).data.approved == true
                 )
               )
             );
    }

    // Published class/lesson documents are also protected in case the newer
    // publication sync path is used by an app build.
    match /published_classes/{publicationId} {
      allow read: if request.auth != null
                  && (
                    resource.data.ownerUid == request.auth.uid
                    || (resource.data.isPublished == true && activeTeacher(resource.data.ownerUid))
                  );
      allow create, update: if approvedTeacher(request.auth.uid)
                            && request.resource.data.ownerUid == request.auth.uid
                            && publicationId == request.auth.uid + '__' + request.resource.data.classId
                            && request.resource.data.isPublished is bool;
      allow delete: if approvedTeacher(request.auth.uid)
                    && resource.data.ownerUid == request.auth.uid;
    }

    match /published_lessons/{publicationId} {
      allow read: if request.auth != null
                  && (
                    resource.data.ownerUid == request.auth.uid
                    || (
                      resource.data.isPublished == true
                      && activeTeacher(resource.data.ownerUid)
                      && resource.data.classId is string
                      && exists(/databases/$(database)/documents/published_classes/$(resource.data.ownerUid + '__' + resource.data.classId))
                      && get(/databases/$(database)/documents/published_classes/$(resource.data.ownerUid + '__' + resource.data.classId)).data.isPublished == true
                    )
                  );
      allow create, update: if approvedTeacher(request.auth.uid)
                            && request.resource.data.ownerUid == request.auth.uid
                            && publicationId == request.auth.uid + '__' + request.resource.data.lessonId
                            && request.resource.data.isPublished is bool
                            && (
                              request.resource.data.isPublished == false
                              || (
                                request.resource.data.classId is string
                                && existsAfter(/databases/$(database)/documents/published_classes/$(request.auth.uid + '__' + request.resource.data.classId))
                                && getAfter(/databases/$(database)/documents/published_classes/$(request.auth.uid + '__' + request.resource.data.classId)).data.isPublished == true
                              )
                            );
      allow delete: if approvedTeacher(request.auth.uid)
                    && resource.data.ownerUid == request.auth.uid;
    }

    match /publication_index/{teacherUid} {
      allow read: if request.auth != null;
      allow create, update: if approvedTeacher(teacherUid)
                            && request.resource.data.ownerUid == teacherUid;
      allow delete: if approvedTeacher(teacherUid)
                    && resource.data.ownerUid == teacherUid;
    }

    // نسخه پشتیبان خصوصی درس‌یار؛ فقط صاحب حساب استاد اجازه دسترسی دارد
    match /teacher_data/{ownerUid} {
      allow read: if request.auth != null
                  && request.auth.uid == ownerUid;

      allow create, update: if approvedTeacher(ownerUid)
                            && request.resource.data.ownerUid == ownerUid;

      allow delete: if approvedTeacher(ownerUid);

      match /records/{recordId} {
        allow read: if request.auth != null
                    && request.auth.uid == ownerUid;
        allow create, update, delete: if approvedTeacher(ownerUid);
      }
    }
  }
}