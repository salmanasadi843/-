rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // تنها مدیر اصلی؛ تغییر نقش مدیر فقط از طریق تغییر کنترل‌شده قوانین ممکن است.
    function isAdmin() {
      return request.auth != null
             && request.auth.uid == 'xgUdnaQ6X0hPobOUwx3SDI0BJVc2';
    }

    // The primary admin identity can also own teacher publications.
    function isPrimaryAdmin(uid) {
      return uid == 'xgUdnaQ6X0hPobOUwx3SDI0BJVc2';
    }

    // All teacher writes require a live approval flag and a TEACHER profile.
    // "approved" remains supported for legacy approval documents.
    function approvedTeacher(uid) {
      return request.auth != null
             && request.auth.uid == uid
             && exists(/databases/$(database)/documents/users/$(uid))
             && get(/databases/$(database)/documents/users/$(uid)).data.role == 'TEACHER'
             && (
               isAdmin()
               || (
                 exists(/databases/$(database)/documents/approved_teachers/$(uid))
                 && (
                   get(/databases/$(database)/documents/approved_teachers/$(uid)).data.enabled == true
                   || get(/databases/$(database)/documents/approved_teachers/$(uid)).data.approved == true
                 )
               )
             );
    }

    // Published content is readable by students only while its owner still
    // has an active trusted approval and a TEACHER profile. Removing approval
    // or changing the role to STUDENT revokes access without deleting content.
    function activeTeacher(uid) {
      return exists(/databases/$(database)/documents/users/$(uid))
             && get(/databases/$(database)/documents/users/$(uid)).data.role == 'TEACHER'
             && (
               isPrimaryAdmin(uid)
               || (
                 exists(/databases/$(database)/documents/approved_teachers/$(uid))
                 && (
                   get(/databases/$(database)/documents/approved_teachers/$(uid)).data.enabled == true
                   || get(/databases/$(database)/documents/approved_teachers/$(uid)).data.approved == true
                 )
               )
             );
    }

    // Root profile: users may create a STUDENT profile and may never change
    // their own role. TEACHER approval must be provisioned by a trusted admin.
    match /users/{userId} {
      allow read: if request.auth != null
                  && (request.auth.uid == userId || isAdmin());

      allow create: if (
                      request.auth != null
                      && request.auth.uid == userId
                      && request.resource.data.role == 'STUDENT'
                    ) || (
                      // The primary admin may provision a missing profile while
                      // approving/revoking an account. Clients still cannot grant themselves TEACHER.
                      isAdmin()
                      && request.resource.data.role in ['TEACHER', 'STUDENT']
                      && request.resource.data.keys().hasOnly(['role', 'name', 'email', 'createdAt', 'updatedAt'])
                    );

      allow update: if request.auth != null
                    && (
                      (request.auth.uid == userId
                       && request.resource.data.role == resource.data.role)
                      || (isAdmin()
                          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role', 'name', 'email', 'updatedAt'])
                          && request.resource.data.role in ['TEACHER', 'STUDENT'])
                    );

      allow delete: if false;
    }

    // Preserve owner-only access to nested user documents without granting
    // the recursive wildcard access to the root profile document.
    match /users/{userId}/{subcollection}/{document=**} {
      allow read, write: if request.auth != null
                         && request.auth.uid == userId;
    }

    // Legacy share links remain public for backward compatibility.
    // Their data classification must be reviewed before changing this policy.
    match /shared/{shareId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null
                            && resource.data.ownerUid == request.auth.uid;
    }

    // مدیر اصلی می‌تواند استادان را تأیید یا لغو کند؛ کاربران عادی فقط می‌خوانند.
    match /approved_teachers/{teacherUid} {
      allow read: if request.auth != null;

      allow create, update: if isAdmin()
                            && request.resource.data.ownerUid == teacherUid
                            && request.resource.data.enabled == true;

      allow delete: if isAdmin();
    }

    // درخواست‌های فعال‌شدن حساب استاد
    match /teacher_requests/{requestUid} {
      allow read: if request.auth != null
                  && (isAdmin() || request.auth.uid == requestUid);

      allow create: if (request.auth != null
                         && request.auth.uid == requestUid
                         && request.resource.data.uid == requestUid
                         && request.resource.data.status == 'PENDING')
                    || (isAdmin()
                        && request.resource.data.uid == requestUid
                        && request.resource.data.status in ['APPROVED', 'REJECTED', 'REVOKED']);

      allow update: if isAdmin()
                    || (request.auth != null
                        && request.auth.uid == requestUid
                        && resource.data.status in ['REJECTED', 'REVOKED']
                        && request.resource.data.uid == requestUid
                        && request.resource.data.status == 'PENDING');
      allow delete: if isAdmin();
    }

    // Legacy aggregate payload is private. Students must use canonical records.
    match /shared_materials/{teacherUid} {
      allow read: if request.auth != null && request.auth.uid == teacherUid;
      allow create, update: if approvedTeacher(teacherUid)
                            && request.resource.data.ownerUid == teacherUid;
      allow delete: if approvedTeacher(teacherUid)
                    && resource.data.ownerUid == teacherUid;
    }

    // Canonical class publication record: hidden class metadata is owner-only.
    match /published_classes/{publicationId} {
      allow read: if request.auth != null
                  && (resource.data.ownerUid == request.auth.uid
                      || (resource.data.isPublished == true
                          && activeTeacher(resource.data.ownerUid)));

      allow create, update: if approvedTeacher(request.auth.uid)
                            && request.resource.data.ownerUid == request.auth.uid
                            && publicationId == request.auth.uid + '__' + request.resource.data.classId
                            && request.resource.data.isPublished is bool;

      allow delete: if approvedTeacher(request.auth.uid)
                    && resource.data.ownerUid == request.auth.uid;
    }

    // A lesson can only be publicly readable if its own flag and parent class
    // flag are true. This is enforced by Firestore, not just by app filtering.
    match /published_lessons/{publicationId} {
      allow read: if request.auth != null
                  && (resource.data.ownerUid == request.auth.uid
                      || (resource.data.isPublished == true
                          && activeTeacher(resource.data.ownerUid)
                          && resource.data.classId is string
                          && exists(/databases/$(database)/documents/published_classes/$(resource.data.ownerUid + '__' + resource.data.classId))
                          && get(/databases/$(database)/documents/published_classes/$(resource.data.ownerUid + '__' + resource.data.classId)).data.isPublished == true));

      allow create, update: if approvedTeacher(request.auth.uid)
                            && request.resource.data.ownerUid == request.auth.uid
                            && publicationId == request.auth.uid + '__' + request.resource.data.lessonId
                            && request.resource.data.isPublished is bool
                            && (request.resource.data.isPublished == false
                                || (request.resource.data.classId is string
                                    && existsAfter(/databases/$(database)/documents/published_classes/$(request.auth.uid + '__' + request.resource.data.classId))
                                    && getAfter(/databases/$(database)/documents/published_classes/$(request.auth.uid + '__' + request.resource.data.classId)).data.isPublished == true));

      allow delete: if approvedTeacher(request.auth.uid)
                    && resource.data.ownerUid == request.auth.uid;
    }

    // Minimal hash-only index allows student clients to hide stale local imports
    // after revocation without disclosing names or transcript content.
    match /publication_index/{teacherUid} {
      allow read: if request.auth != null;
      allow create, update: if approvedTeacher(teacherUid)
                            && request.resource.data.ownerUid == teacherUid;
      allow delete: if approvedTeacher(teacherUid)
                    && resource.data.ownerUid == teacherUid;
    }

    // Private teacher backup: both profile role and trusted approval are needed.
    match /teacher_data/{ownerUid} {
      allow read: if request.auth != null
                  && request.auth.uid == ownerUid;

      allow create, update: if approvedTeacher(ownerUid)
                            && request.resource.data.ownerUid == ownerUid;

      allow delete: if approvedTeacher(ownerUid);

      // Individual sync records are private and restricted to approved teachers.
      match /records/{recordId} {
        allow read: if request.auth != null
                    && request.auth.uid == ownerUid;

        allow create, update, delete: if approvedTeacher(ownerUid);
      }
    }
  }
}