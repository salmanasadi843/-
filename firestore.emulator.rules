rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Emulator-only rules. Never deploy this permissive test policy.
    // AuthPreferences.login reads the signed-in user's profile and approval record.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    match /approved_teachers/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    match /shared_materials/{uid} {
      allow read, write: if true;
      match /records/{recordId} {
        allow read, write: if true;
      }
    }
    match /teacher_data/{uid} {
      allow read, write: if true;
      match /records/{recordId} {
        allow read: if true;
        allow create, update: if !('name' in request.resource.data)
                              || request.resource.data.name != 'FORCE_FAILURE';
      }
    }
  }
}
