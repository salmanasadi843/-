# Copy to .env.local and provide the Firebase Web App config for the existing Darsyar Firebase project.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# Backend URL, e.g. https://api.example.org (must be HTTPS outside local development).
DARSYAR_API_BASE_URL=http://localhost:8080